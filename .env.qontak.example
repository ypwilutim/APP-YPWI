# ─── Mekari Qontak Omnichannel ────────────────────────────────

# Dapatkan dari: Dashboard Qontak → Settings → Developer → API Credential
MEKARI_APP_ID=your_app_id_here
MEKARI_APP_SECRET=<SECRET_4b3d7d28>t_here

# (opsional) Jika kamu ingin hardcode token statis daripada auto-fetch
# MEKARI_ACCESS_TOKEN=

# Nomor WA terdaftar di Qontak (untuk quick-blast / template)
MEKARI_WA_NUMBER_ID=62812xxxxxxx

# Webhook secret — set dari dashboard Qontak → Settings → Webhook
# MEKARI_WEBHOOK_SECRET=your_webhook_secret

# Base URL override (ubah kalau Qontak mengganti)
# MEKARI_BASE_URL=https://api.qontak.com/omni
